# Modèle de configuration. Copier en .env.local et remplir.
# Les valeurs se trouvent dans Supabase : Paramètres, Clés API, et
# Paramètres, API de données pour l'URL du projet.
#
# Ne pas ajouter de clé secrète ici sans nécessité démontrée : une clé
# secrète ignore toutes les politiques RLS.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
